<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Send_Reminder</name>
        <label>Send Reminder via Apex</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>WMF_MealReminderHelper</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Stamp_Reminder_Sent</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>profileEmail</name>
            <value>
                <elementReference>Get_User.Email</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>profileName</name>
            <value>
                <elementReference>Get_Nutrition_Profile.Name</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>profileUserId</name>
            <value>
                <elementReference>Get_Nutrition_Profile.User__c</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>profileId</name>
            <value>
                <elementReference>Get_Nutrition_Profile.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>WMF_MealReminderHelper</nameSegment>
    </actionCalls>
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Has_Email</name>
        <label>User Has Email?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No email — skip</defaultConnectorLabel>
        <rules>
            <name>Has_Email_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_User.Email</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Reminder</targetReference>
            </connector>
            <label>Yes — send reminder</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_User</name>
        <label>Profile Has Linked User?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No user — skip</defaultConnectorLabel>
        <rules>
            <name>Has_User_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Nutrition_Profile.User__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_User</targetReference>
            </connector>
            <label>Yes — load user</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Still_Latest</name>
        <label>Is This Still the Latest Meal?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No — newer meal logged, skip</defaultConnectorLabel>
        <rules>
            <name>Yes_Still_Latest</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Latest_Meal.Id</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Id</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Nutrition_Profile</targetReference>
            </connector>
            <label>Yes — no newer meal, proceed</label>
        </rules>
    </decisions>
    <description>Fires 15 hours after a Meal record is created. If no newer meal exists for the same Nutrition Profile and the profile has an email address, calls WMF_MealReminderHelper to send a randomised bell notification and HTML email reminder.</description>
    <environments>Default</environments>
    <label>WMF Meal Reminder Scheduler</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Latest_Meal</name>
        <label>Get Latest Meal for Profile</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_Still_Latest</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Nutrition_Profile__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Nutrition_Profile__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Meal__c</object>
        <queriedFields>Id</queriedFields>
        <sortField>Logged_DateTime__c</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Nutrition_Profile</name>
        <label>Get Nutrition Profile</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_User</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Nutrition_Profile__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Nutrition_Profile__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>User__c</queriedFields>
        <queriedFields>Name</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_User</name>
        <label>Get Profile User</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_Email</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Nutrition_Profile.User__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>User</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Email</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Stamp_Reminder_Sent</name>
        <label>Stamp Reminder Sent Timestamp</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Nutrition_Profile.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Last_Meal_Reminder_Sent__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <object>Nutrition_Profile__c</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterFormula>NOT(ISBLANK({!$Record.Nutrition_Profile__c}))</filterFormula>
        <object>Meal__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <scheduledPaths>
            <name>Fifteen_Hours_After_Meal</name>
            <connector>
                <targetReference>Get_Latest_Meal</targetReference>
            </connector>
            <label>15 Hours After Meal Logged</label>
            <offsetNumber>15</offsetNumber>
            <offsetUnit>Hours</offsetUnit>
            <recordField>Logged_DateTime__c</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
